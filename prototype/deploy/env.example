# copy to .env (never commit it)
GAME_DOMAIN=triund.example.com
VOICE_DOMAIN=voice.triund.example.com

# any long random strings (e.g. `openssl rand -hex 24`); the server mints voice tokens with them
LIVEKIT_API_KEY=triund
LIVEKIT_API_SECRET=change-me-to-a-long-random-secret

# chatting with the people on the trail (optional: without it they answer with short written lines)
ANTHROPIC_API_KEY=
TRIUND_TALK_PER_MIN=20
